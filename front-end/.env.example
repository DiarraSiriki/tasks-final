# URL de l'API.
# Vide = même origine : les appels /api, /tasks, /users et /examples passent
# par le proxy Vite (développement) ou par le reverse proxy de production.
# Renseigner une URL absolue uniquement si le backend est exposé sur un autre
# domaine et que CORS est configuré côté backend.
VITE_API_URL=

# Cible du proxy Vite (jamais exposée au navigateur).
VITE_PROXY_TARGET=http://localhost:3000

# Uniquement pour docker-compose.yml (qui inclut aussi le backend).
# Doit être identique au BETTER_AUTH_SECRET du backend. Générer avec :
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
