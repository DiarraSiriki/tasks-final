# URL de l'API.
# Vide = même origine : les appels /api, /tasks et /examples passent par le
# proxy Vite (développement) ou par le reverse proxy de production.
# Renseigner une URL absolue uniquement si le backend est exposé sur un autre
# domaine et que CORS est configuré côté backend.
VITE_API_URL=

# Cible du proxy Vite (jamais exposée au navigateur).
VITE_PROXY_TARGET=http://localhost:3000
